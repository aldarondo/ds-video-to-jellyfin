{
  "name": "ds-video-to-jellyfin",
  "version": "1.0.0",
  "description": "Migrate a Synology DS Video collection to a Jellyfin-compatible folder structure — reorganizes files, generates .nfo metadata, and extracts artwork from .vsmeta sidecars",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "ds-video-to-jellyfin": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run prepublishOnly && changeset publish"
  },
  "keywords": [
    "synology",
    "ds-video",
    "video-station",
    "jellyfin",
    "vsmeta",
    "media",
    "migration",
    "nfo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "nfo-to-json": "^1.0.0",
    "parse-torrent-path": "^1.0.0",
    "vsmeta-parser": "^1.0.1",
    "vsmeta-to-jpeg": "^1.0.0",
    "vsmeta-to-nfo": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
